# Existing, SELECT-only business account. Do not commit actual credentials.
LANG2SQL_DB_URL=oracle+oracledb://L2S_VIEW_READER:REPLACE@127.0.0.1:11522/?service_name=FREEPDB1
LANG2SQL_DB_SCHEMA=l2s_view_owner
# Separate metadata account; --metadata-url-env names this variable.
LANG2SQL_METADATA_URL=oracle+oracledb://L2S_METADATA:REPLACE@127.0.0.1:11522/?service_name=FREEPDB1
# Integration tests only, on a dedicated metadata schema.
LANG2SQL_TEST_METADATA_URL=oracle+oracledb://L2S_METADATA:REPLACE@127.0.0.1:11522/?service_name=FREEPDB1
